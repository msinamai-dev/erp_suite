# Existing ERP database settings
DB_NAME=ErpDB
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# POS database settings (read-only operational data)
POS_DB_NAME=posApp
POS_DB_HOST=localhost\SQLEXPRESS
POS_DB_PORT=
POS_DB_USER=
POS_DB_PASSWORD=
POS_DB_DRIVER=ODBC Driver 17 for SQL Server
POS_DB_EXTRA_PARAMS=TrustServerCertificate=yes;

# Set the SAME strong secret in ERP and POS processes.
POS_LINK_SHARED_SECRET=replace-with-a-long-random-secret
# Must be reachable from the owner's browser; set the same ERP base in POS.
ERP_PUBLIC_BASE_URL=http://127.0.0.1:8001
POS_PUBLIC_BASE_URL=http://127.0.0.1:8000
